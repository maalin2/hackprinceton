# Kalshi Trading API
# No API key needed for read-only market data
# For trading, visit: https://kalshi.com/api

# Weather Data Providers
# Visual Crossing API (Free tier: 1000 requests/day)
# Get key at: https://www.visualcrossing.com/weather-api
NEXT_PUBLIC_VISUAL_CROSSING_KEY=your_visual_crossing_key_here

# Financial & Crypto Data
# CoinGecko API (Free - no key needed for basic endpoints)
# For higher rate limits: https://www.coingecko.com/en/api

# CryptoPanic News API (Free tier: 50 requests/hour)
# Get key at: https://cryptopanic.com/developers/api/
NEXT_PUBLIC_CRYPTOPANIC_KEY=your_cryptopanic_key_here

# News APIs
# NewsAPI (Free tier: 100 requests/day)
# Get key at: https://newsapi.org/register
NEXT_PUBLIC_NEWS_API_KEY=your_newsapi_key_here

# Search & Trends
# SerpAPI for Google Trends (Free tier: 100 searches/month)
# Get key at: https://serpapi.com/
NEXT_PUBLIC_SERPAPI_KEY=your_serpapi_key_here

# Social Media APIs
# Twitter/X API v2 Bearer Token (Free tier: 500k tweets/month)
# Get key at: https://developer.twitter.com/en/portal/dashboard
NEXT_PUBLIC_TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Optional: Mock Mode Flags
# Set to "false" to disable mock data and use real APIs
NEXT_PUBLIC_MOCK_QUANT=false
NEXT_PUBLIC_MOCK_SENTIMENT=false

# Optional: WebSocket URL for real-time recommendations
# Leave blank to use mock WebSocket mode
NEXT_PUBLIC_WS_URL=ws://localhost:8080/agent-feed

